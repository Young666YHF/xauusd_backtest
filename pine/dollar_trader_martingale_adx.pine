// XAUUSD Dollar Trader Martingale BBW Step Strategy - Pine Script v6
// 策略: 三线SMA趋势跟踪 (20/50/200) + BBW波动率过滤 + 阶梯式马丁格尔
//
// 核心逻辑:
//   - 入场逻辑: SMA排列 + BBW>MA(BBW,50)
//   - BBW = (Upper - Lower) / Middle × 100
//   - 阶梯式马丁: 亏损2次→阶梯+1, 盈利1次→阶梯-1
//   - 最大层数继续亏损→超调计数, 超调时盈利先消耗计数
//
// 【关键一致性设置】
// - process_orders_on_close=false: 确保在K线开盘时执行
// - 使用 strategy.entry 执行入场订单
// - 使用 [1] 位移获取上一根K线数据判断，避免未来函数

//@version=6
strategy("XAUUSD Dollar Trader Martingale BBW Step (SMA 20/50/200)", overlay=true,
         initial_capital=100000,
         default_qty_type=strategy.fixed,
         default_qty_value=1,
         commission_type=strategy.commission.cash_per_contract,
         commission_value=7.0,  // $3.5 单边 = $7 往返
         slippage=10,           // 10点 = $0.1
         calc_on_every_tick=false,
         process_orders_on_close=false,  // 【关键】在K线开盘时执行订单
         max_lines_count=500,
         max_labels_count=500)

// ============================================
// 参数设置
// ============================================
smaShortPeriod = input.int(20, "短期SMA周期", minval=10, maxval=30, group="SMA参数")
smaMediumPeriod = input.int(50, "中期SMA周期", minval=30, maxval=70, group="SMA参数")
smaLongPeriod = input.int(200, "长期SMA周期", minval=100, maxval=300, group="SMA参数")

// 布林带参数
groupBB = "布林带参数"
bbPeriod = input.int(20, "布林带周期", minval=10, maxval=30, group=groupBB)
bbStd = input.float(2.0, "布林带标准差", minval=1.0, maxval=3.0, step=0.1, group=groupBB)
bbwMaPeriod = input.int(50, "BBW均线周期", minval=20, maxval=100, group=groupBB)

// 马丁格尔参数
groupMartingale = "阶梯式马丁参数"
positionSize = input.float(1.0, "基础仓位", minval=0.1, maxval=10.0, step=0.1, group=groupMartingale)
martingaleMultiplier = input.float(2.0, "马丁倍数", minval=1.1, maxval=5.0, step=0.1, group=groupMartingale)
maxMartingaleSteps = input.int(5, "最大阶梯层级", minval=1, maxval=10, group=groupMartingale)
enableOvershoot = input.bool(true, "启用超调计数", group=groupMartingale)
enableUndershoot = input.bool(true, "启用欠调计数", group=groupMartingale)

// ============================================
// 指标计算
// ============================================
// 计算三条SMA
smaShort = ta.sma(close, smaShortPeriod)
smaMedium = ta.sma(close, smaMediumPeriod)
smaLong = ta.sma(close, smaLongPeriod)

// 计算布林带
bbBasis = ta.sma(close, bbPeriod)
bbDev = bbStd * ta.stdev(close, bbPeriod)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// 计算BBW (Bollinger Band Width)
bbw = (bbUpper - bbLower) / bbBasis * 100

// 计算BBW均线
bbwMa = ta.sma(bbw, bbwMaPeriod)

// ============================================
// 【关键】使用上一根K线(已收盘)的数据判断信号
// ============================================
prevClose = close[1]
prevSMA_S = smaShort[1]
prevSMA_M = smaMedium[1]
prevSMA_L = smaLong[1]
prevBBW = bbw[1]
prevBBW_MA = bbwMa[1]

// 前两根K线的SMA值 (用于判断交叉)
prev2SMA_S = smaShort[2]
prev2SMA_M = smaMedium[2]

// ============================================
// 趋势判断 (基于上一根K线)
// ============================================
// 多头排列: C > SMA_S > SMA_M > SMA_L
isBullish = (prevClose > prevSMA_S) and (prevSMA_S > prevSMA_M) and (prevSMA_M > prevSMA_L)

// 空头排列: C < SMA_S < SMA_M < SMA_L
isBearish = (prevClose < prevSMA_S) and (prevSMA_S < prevSMA_M) and (prevSMA_M < prevSMA_L)

// ============================================
// 交叉判断 (用于出场)
// ============================================
// 短期下穿中期 (死叉) - 多头平仓信号
smaBearishCross = (prev2SMA_S >= prev2SMA_M) and (prevSMA_S < prevSMA_M)

// 短期上穿中期 (金叉) - 空头平仓信号
smaBullishCross = (prev2SMA_S <= prev2SMA_M) and (prevSMA_S > prevSMA_M)

// ============================================
// BBW波动率判断 (入场过滤)
// ============================================
bbwAllowEntry = not na(prevBBW) and not na(prevBBW_MA) and (prevBBW > prevBBW_MA)

// ============================================
// 获取策略持仓状态
// ============================================
bool hasLongPosition = strategy.position_size > 0
bool hasShortPosition = strategy.position_size < 0
bool hasPosition = hasLongPosition or hasShortPosition

// ============================================
// 阶梯式马丁状态管理
// ============================================
// 使用 var 关键字保持状态跨K线
var int martingaleStep = 0           // 当前阶梯层级
var int lossCountInStep = 0          // 当前阶梯下连续亏损次数
var int overshootCount = 0           // 超调计数（最大层数继续亏损）
var int undershootCount = 0          // 欠调计数（0层继续盈利）
var float lastTradeProfit = 0.0

// ============================================
// 检测交易完成并更新马丁格尔状态
// ============================================
// 检测仓位变化 (从有到无表示平仓)
bool wasLongExit = hasLongPosition[1] and not hasLongPosition
bool wasShortExit = hasShortPosition[1] and not hasShortPosition
bool wasExit = wasLongExit or wasShortExit

// 获取当前盈亏 (只在平仓时更新)
float currentProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)

// 更新马丁格尔阶梯状态
if wasExit
    lastTradeProfit := currentProfit

    if currentProfit < 0
        // ========== 亏损处理 ==========
        lossCountInStep := lossCountInStep + 1

        if lossCountInStep >= 2
            // 需要上升阶梯
            if martingaleStep < maxMartingaleSteps
                // 正常上升
                martingaleStep := martingaleStep + 1
                lossCountInStep := 0
                // 如果启用欠调计数且有欠调计数，消耗一个
                if enableUndershoot and undershootCount > 0
                    undershootCount := undershootCount - 1
                log.info("【阶梯马丁】亏损2次，阶梯上升: " + str.tostring(martingaleStep))
            else
                // 已经在最大层数
                if enableOvershoot
                    // 启用超调计数，累积超调计数
                    overshootCount := overshootCount + 1
                    lossCountInStep := 0
                    log.info("【阶梯马丁】最大层数继续亏损，超调计数: " + str.tostring(overshootCount))
                // 如果未启用超调，保持当前状态
    else
        // ========== 盈利处理 ==========
        lossCountInStep := 0

        if enableOvershoot and overshootCount > 0
            // 有超调计数且启用，先消耗计数（不降阶梯）
            overshootCount := overshootCount - 1
            log.info("【阶梯马丁】盈利，消耗超调计数，保持阶梯: " + str.tostring(martingaleStep))
        else if martingaleStep > 0
            // 正常下降阶梯
            martingaleStep := martingaleStep - 1
            log.info("【阶梯马丁】盈利，阶梯下降: " + str.tostring(martingaleStep))
        else
            // 已经在0层
            if enableUndershoot
                // 启用欠调计数，累积欠调计数
                undershootCount := undershootCount + 1
                log.info("【阶梯马丁】0层继续盈利，欠调计数: " + str.tostring(undershootCount))
            // 如果未启用欠调，不做任何操作

// ============================================
// 计算当前阶梯式马丁仓位
// ============================================
float currentPositionSize = positionSize * math.pow(martingaleMultiplier, martingaleStep)

// ============================================
// 【关键】出场逻辑
// ============================================
// 多头出场: SMA_20下穿SMA_50
if hasLongPosition and smaBearishCross
    if isBearish
        strategy.close("Long", comment="SMA死叉反向")
    else
        strategy.close("Long", comment="SMA死叉平仓")

// 空头出场: SMA_20上穿SMA_50
if hasShortPosition and smaBullishCross
    if isBullish
        strategy.close("Short", comment="SMA金叉反向")
    else
        strategy.close("Short", comment="SMA金叉平仓")

// ============================================
// 【关键】入场逻辑 (带BBW过滤)
// ============================================
// 多头入场
if not hasPosition and isBullish and bbwAllowEntry
    strategy.entry("Long", strategy.long, qty=currentPositionSize, comment="多头排列_S" + str.tostring(martingaleStep))

// 空头入场
if not hasPosition and isBearish and bbwAllowEntry
    strategy.entry("Short", strategy.short, qty=currentPositionSize, comment="空头排列_S" + str.tostring(martingaleStep))

// 反向开仓 (持有多头时收到空头信号) - 需要BBW允许
if hasLongPosition and isBearish and smaBearishCross and bbwAllowEntry
    strategy.entry("Short", strategy.short, qty=currentPositionSize, comment="多转空_S" + str.tostring(martingaleStep))

// 反向开仓 (持有空头时收到多头信号) - 需要BBW允许
if hasShortPosition and isBullish and smaBullishCross and bbwAllowEntry
    strategy.entry("Long", strategy.long, qty=currentPositionSize, comment="空转多_S" + str.tostring(martingaleStep))

// ============================================
// 绘图
// ============================================
plot(smaShort, "SMA_20", color=color.new(color.blue, 20), linewidth=2)
plot(smaMedium, "SMA_50", color=color.new(color.orange, 20), linewidth=2)
plot(smaLong, "SMA_200", color=color.new(color.red, 20), linewidth=1)

// 布林带
plot(bbUpper, "BB_Upper", color=color.new(color.gray, 50), linewidth=1)
plot(bbLower, "BB_Lower", color=color.new(color.gray, 50), linewidth=1)

// 信号标记
plotshape(isBullish and not hasPosition[1] and hasPosition, "Long Entry",
          shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(isBearish and not hasPosition[1] and hasPosition, "Short Entry",
          shape.triangledown, location.abovebar, color.red, size=size.small)

// ============================================
// 信息面板
// ============================================
var table infoPanel = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoPanel, 0, 0, "趋势状态", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 1, "SMA_20", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 2, "SMA_50", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 3, "SMA_200", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 4, "持仓", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 5, "BBW", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 6, "BBW_MA", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 7, "BBW过滤", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 8, "马丁阶梯", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 9, "阶梯内亏损", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 10, "超调计数", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 0, 11, "当前仓位", text_color=color.white, text_size=size.small)

    // 趋势状态颜色
    trendColor = isBullish ? color.green : (isBearish ? color.red : color.gray)
    trendText = isBullish ? "多头" : (isBearish ? "空头" : "震荡")

    // 持仓状态
    positionText = hasLongPosition ? "多头" : (hasShortPosition ? "空头" : "空仓")
    positionColor = hasLongPosition ? color.green : (hasShortPosition ? color.red : color.gray)

    // BBW过滤状态
    bbwFilterText = bbwAllowEntry ? "通过" : "阻断"
    bbwFilterColor = bbwAllowEntry ? color.green : color.red

    // 马丁阶梯颜色
    stepColor = martingaleStep == 0 ? color.green : (martingaleStep >= maxMartingaleSteps ? color.red : color.orange)

    table.cell(infoPanel, 1, 0, trendText, text_color=trendColor, text_size=size.small)
    table.cell(infoPanel, 1, 1, str.tostring(smaShort, "#.##"), text_color=color.blue, text_size=size.small)
    table.cell(infoPanel, 1, 2, str.tostring(smaMedium, "#.##"), text_color=color.orange, text_size=size.small)
    table.cell(infoPanel, 1, 3, str.tostring(smaLong, "#.##"), text_color=color.red, text_size=size.small)
    table.cell(infoPanel, 1, 4, positionText, text_color=positionColor, text_size=size.small)
    table.cell(infoPanel, 1, 5, str.tostring(prevBBW, "#.##"), text_color=color.blue, text_size=size.small)
    table.cell(infoPanel, 1, 6, str.tostring(prevBBW_MA, "#.##"), text_color=color.orange, text_size=size.small)
    table.cell(infoPanel, 1, 7, bbwFilterText, text_color=bbwFilterColor, text_size=size.small)
    table.cell(infoPanel, 1, 8, str.tostring(martingaleStep), text_color=stepColor, text_size=size.small)
    table.cell(infoPanel, 1, 9, str.tostring(lossCountInStep), text_color=color.yellow, text_size=size.small)
    table.cell(infoPanel, 1, 10, str.tostring(overshootCount), text_color=color.red, text_size=size.small)
    table.cell(infoPanel, 1, 11, str.tostring(currentPositionSize, "#.##"), text_color=color.yellow, text_size=size.small)

// 背景色标注趋势
bgcolor(isBullish[1] ? color.new(color.green, 95) : (isBearish[1] ? color.new(color.red, 95) : na))

// 马丁格尔阶梯背景色提示
bgcolor(martingaleStep > 0 ? color.new(color.orange, 95 - martingaleStep * 5) : na, title="马丁阶梯")
