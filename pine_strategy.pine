//
// 2026-03-24 v6.0 新增策略C (SMA角度突破):
// - 【新增】策略C: SMA角度(ATR标准化) + K线突破
// - 【新增】角度计算: θ = atan((SMA[t]-SMA[t-n])/(ATR[t]*n)) * (180/π)
// - 【新增】突破确认: 突破前N根K线高低点
//
// 2026-03-22 v5.2 核心逻辑缺陷修复:
// - 【修复】并发持仓: 策略A/B/C独立状态追踪

//@version=6
strategy("XAUUSD Triple Strategy v6", overlay=true,
         initial_capital=100000,
         default_qty_type=strategy.fixed,
         default_qty_value=1,
         commission_type=strategy.commission.cash_per_contract,
         commission_value=0.6,
         slippage=1,
         pyramiding=0)

// ============================================
// 策略参数
// ============================================

// 布林带参数 (策略A)
bb_period = input.int(20, "布林带周期", minval=5, maxval=50, group="策略A - 均值回归")
bb_std = input.float(2.0, "布林带标准差", minval=1.0, maxval=4.0, step=0.01, group="策略A - 均值回归")
rsi_period = input.int(14, "RSI周期", minval=5, maxval=30, group="策略A - 均值回归")
rsi_oversold = input.int(25, "RSI超卖阈值", minval=10, maxval=40, group="策略A - 均值回归")
rsi_overbought = input.int(75, "RSI超买阈值", minval=60, maxval=90, group="策略A - 均值回归")
stop_loss_atr_mult_a = input.float(1.0, "止损ATR倍数", minval=0.5, maxval=5.0, step=0.01, group="策略A - 均值回归")
max_hold_bars_a = input.int(5, "最大持仓K线数", minval=3, maxval=15, group="策略A - 均值回归")

// EMA参数 (策略B)
ema_fast_len = input.int(20, "EMA快线周期", minval=5, maxval=50, group="策略B - 动量突破")
ema_slow_len = input.int(50, "EMA慢线周期", minval=20, maxval=100, group="策略B - 动量突破")
stop_loss_atr_mult_b = input.float(1.2, "止损ATR倍数", minval=0.5, maxval=5.0, step=0.01, group="策略B - 动量突破")
trailing_stop_atr_mult = input.float(2.5, "追踪止损ATR倍数", minval=1.0, maxval=8.0, step=0.01, group="策略B - 动量突破")

// 策略C参数 (SMA角度突破)
sma_period_c = input.int(20, "SMA周期", minval=10, maxval=50, group="策略C - 趋势角度突破")
angle_lookback_c = input.int(5, "角度回看K线数", minval=3, maxval=10, group="策略C - 趋势角度突破")
angle_threshold_c = input.float(3.0, "角度阈值(度)", minval=1.0, maxval=10.0, step=0.5, group="策略C - 趋势角度突破")
breakout_lookback_c = input.int(2, "突破回看K线数", minval=1, maxval=5, group="策略C - 趋势角度突破")
use_fixed_exit_c = input.bool(true, "使用固定盈亏比出场", group="策略C - 趋势角度突破")
risk_reward_ratio_c = input.float(2.0, "盈亏比", minval=1.0, maxval=4.0, step=0.1, group="策略C - 趋势角度突破")
stop_loss_atr_mult_c = input.float(2.0, "止损ATR倍数", minval=1.0, maxval=4.0, step=0.1, group="策略C - 趋势角度突破")

// 通用参数
atr_period = input.int(14, "ATR周期", minval=5, maxval=30, group="通用")

// 交易时段设置
grp_time = "交易时段"
asian_start = input.int(6, "亚盘开始(北京时间)", minval=0, maxval=23, group=grp_time)
asian_end = input.int(14, "亚盘结束(北京时间)", minval=0, maxval=23, group=grp_time)
european_start = input.int(15, "欧美盘开始(北京时间)", minval=0, maxval=23, group=grp_time)
european_end = input.int(2, "欧美盘结束(北京时间)", minval=0, maxval=6, group=grp_time)

// 策略开关
enable_strategy_a = input.bool(true, "启用策略A (均值回归)", group="开关")
enable_strategy_b = input.bool(true, "启用策略B (动量突破)", group="开关")
enable_strategy_c = input.bool(true, "启用策略C (趋势角度突破)", group="开关")

// ============================================
// 技术指标计算
// ============================================

// 布林带
bb_middle = ta.sma(close, bb_period)
bb_std_dev = ta.stdev(close, bb_period)
bb_upper = bb_middle + bb_std * bb_std_dev
bb_lower = bb_middle - bb_std * bb_std_dev

// ATR和RSI
atr = ta.atr(atr_period)
rsi = ta.rsi(close, rsi_period)

// EMA (策略B)
ema_fast_val = ta.ema(close, ema_fast_len)
ema_slow_val = ta.ema(close, ema_slow_len)

// 策略C SMA
sma_c = ta.sma(close, sma_period_c)
sma_c_prev = sma_c[angle_lookback_c]

// VWAP
vwap_val = ta.vwap(hlc3)

// ============================================
// 时区判断
// ============================================
current_hour = hour(time, "Asia/Shanghai")
is_asian_session = (current_hour >= asian_start) and (current_hour < asian_end)
is_european_session = (current_hour >= european_start) or (current_hour < european_end)

// ============================================
// 策略C - SMA角度计算
// ============================================
// θ = atan((SMA[t] - SMA[t-n]) / (ATR[t] * n)) * (180/π)
sma_diff_c = sma_c - sma_c_prev
angle_rad_c = math.atan(sma_diff_c / (atr * angle_lookback_c))
angle_deg_c = angle_rad_c * 180.0 / math.pi

// 策略C - 计算前N根K线的高低点
highest_n_c = ta.highest(high[1], breakout_lookback_c)
lowest_n_c = ta.lowest(low[1], breakout_lookback_c)

// ============================================
// 策略状态变量
// ============================================

// 策略A状态
var string strategy_a_state = ""
var int bars_held_a = 0
var float entry_price_a = 0.0
var float fixed_stop_loss_a = 0.0

// 策略B状态
var string strategy_b_state = ""
var int bars_held_b = 0
var float entry_price_b = 0.0
var float fixed_stop_loss_b = 0.0
var float highest_since_entry_b = 0.0
var float lowest_since_entry_b = 1000000.0

// 策略C状态
var string strategy_c_state = ""
var int bars_held_c = 0
var float entry_price_c = 0.0
var float highest_since_entry_c = 0.0
var float lowest_since_entry_c = 1000000.0

// 策略B挂单状态
var int pending_order_id = 0
var float pending_entry_price = 0.0
var float pending_stop_loss = 0.0
var int pending_bars = 0

// ============================================
// 持仓状态检查
// ============================================
has_position_a = strategy_a_state != ""
has_position_b = strategy_b_state != ""
has_position_c = strategy_c_state != ""
is_long_a = strategy_a_state == "LONG"
is_short_a = strategy_a_state == "SHORT"
is_long_b = strategy_b_state == "LONG"
is_short_b = strategy_b_state == "SHORT"
is_long_c = strategy_c_state == "LONG"
is_short_c = strategy_c_state == "SHORT"

// ============================================
// 出场逻辑
// ============================================

// === 策略A出场 ===
if has_position_a
    bars_held_a := bars_held_a + 1

    if is_long_a
        if low <= fixed_stop_loss_a
            strategy.close("Long_A", comment="A止损")
            strategy_a_state := ""
            bars_held_a := 0
        else if high >= vwap_val
            strategy.close("Long_A", comment="A_VWAP止盈")
            strategy_a_state := ""
            bars_held_a := 0
        else if bars_held_a >= max_hold_bars_a
            strategy.close("Long_A", comment="A时间止损")
            strategy_a_state := ""
            bars_held_a := 0
    else if is_short_a
        if high >= fixed_stop_loss_a
            strategy.close("Short_A", comment="A止损")
            strategy_a_state := ""
            bars_held_a := 0
        else if low <= vwap_val
            strategy.close("Short_A", comment="A_VWAP止盈")
            strategy_a_state := ""
            bars_held_a := 0
        else if bars_held_a >= max_hold_bars_a
            strategy.close("Short_A", comment="A时间止损")
            strategy_a_state := ""
            bars_held_a := 0

// === 策略B出场 ===
if has_position_b
    bars_held_b := bars_held_b + 1
    highest_since_entry_b := math.max(highest_since_entry_b, high)
    lowest_since_entry_b := math.min(lowest_since_entry_b, low)

    if is_long_b
        if low <= fixed_stop_loss_b
            strategy.close("Long_B", comment="B初始止损")
            strategy_b_state := ""
            bars_held_b := 0
            highest_since_entry_b := 0.0
        else
            trailing_stop = highest_since_entry_b - trailing_stop_atr_mult * atr
            if low <= trailing_stop and highest_since_entry_b > entry_price_b
                strategy.close("Long_B", comment="B追踪止损")
                strategy_b_state := ""
                bars_held_b := 0
                highest_since_entry_b := 0.0
    else if is_short_b
        if high >= fixed_stop_loss_b
            strategy.close("Short_B", comment="B初始止损")
            strategy_b_state := ""
            bars_held_b := 0
            lowest_since_entry_b := 1000000.0
        else
            trailing_stop = lowest_since_entry_b + trailing_stop_atr_mult * atr
            if high >= trailing_stop and lowest_since_entry_b < entry_price_b
                strategy.close("Short_B", comment="B追踪止损")
                strategy_b_state := ""
                bars_held_b := 0
                lowest_since_entry_b := 1000000.0

// === 策略C出场 ===
if has_position_c
    bars_held_c := bars_held_c + 1
    highest_since_entry_c := math.max(highest_since_entry_c, high)
    lowest_since_entry_c := math.min(lowest_since_entry_c, low)

    // 预计算止损距离以避免重复乘法
    sl_distance_c = stop_loss_atr_mult_c * atr

    if is_long_c
        // 固定止损出场
        if strategy.position_avg_price - sl_distance_c >= low
            strategy.close("Long_C", comment="C止损")
            strategy_c_state := ""
            bars_held_c := 0
        // 固定止盈出场
        else if use_fixed_exit_c and strategy.position_avg_price + risk_reward_ratio_c * sl_distance_c <= high
            strategy.close("Long_C", comment="C止盈")
            strategy_c_state := ""
            bars_held_c := 0
        // 追踪止损出场
        else
            trailing_stop_c = highest_since_entry_c - sl_distance_c
            if low <= trailing_stop_c and highest_since_entry_c > entry_price_c
                strategy.close("Long_C", comment="C追踪止损")
                strategy_c_state := ""
                bars_held_c := 0
                highest_since_entry_c := 0.0
    else if is_short_c
        // 固定止损出场
        if strategy.position_avg_price + sl_distance_c <= high
            strategy.close("Short_C", comment="C止损")
            strategy_c_state := ""
            bars_held_c := 0
        // 固定止盈出场
        else if use_fixed_exit_c and strategy.position_avg_price - risk_reward_ratio_c * sl_distance_c >= low
            strategy.close("Short_C", comment="C止盈")
            strategy_c_state := ""
            bars_held_c := 0
        // 追踪止损出场
        else
            trailing_stop_c = lowest_since_entry_c + sl_distance_c
            if high >= trailing_stop_c and lowest_since_entry_c < entry_price_c
                strategy.close("Short_C", comment="C追踪止损")
                strategy_c_state := ""
                bars_held_c := 0
                lowest_since_entry_c := 1000000.0

// ============================================
// 策略B挂单管理
// ============================================
if pending_order_id != 0
    pending_bars := pending_bars + 1
    if pending_bars >= 4  // 4根K线后过期
        strategy.cancel(pending_order_id)
        pending_order_id := 0
        pending_bars := 0

// ============================================
// 入场信号
// ============================================

// === 策略A入场 ===
long_signal_a = enable_strategy_a and is_asian_session and (close[1] <= bb_lower[1]) and (rsi[1] < rsi_oversold) and not has_position_a
short_signal_a = enable_strategy_a and is_asian_session and (close[1] >= bb_upper[1]) and (rsi[1] > rsi_overbought) and not has_position_a

if long_signal_a
    sl_price = close - stop_loss_atr_mult_a * atr
    tp_price = vwap_val > close ? vwap_val : close + math.abs(close - sl_price) * 2.0
    strategy.entry("Long_A", strategy.long)
    strategy_a_state := "LONG"
    entry_price_a := close
    fixed_stop_loss_a := sl_price
    bars_held_a := 0

if short_signal_a
    sl_price = close + stop_loss_atr_mult_a * atr
    tp_price = vwap_val < close ? vwap_val : close - math.abs(close - sl_price) * 2.0
    strategy.entry("Short_A", strategy.short)
    strategy_a_state := "SHORT"
    entry_price_a := close
    fixed_stop_loss_a := sl_price
    bars_held_a := 0

// === 策略B入场 ===
ema_bullish = ema_fast_val > ema_slow_val * 1.0005
ema_bearish = ema_fast_val < ema_slow_val * 0.9995

long_signal_b = enable_strategy_b and is_european_session and (close[1] > bb_upper[1]) and (close[2] <= bb_upper[2]) and ema_bullish and not has_position_b and pending_order_id == 0
short_signal_b = enable_strategy_b and is_european_session and (close[1] < bb_lower[1]) and (close[2] >= bb_lower[2]) and ema_bearish and not has_position_b and pending_order_id == 0

if long_signal_b
    entry_price := high[1]
    prev_low := low[2]
    sl_price = math.max(entry_price - stop_loss_atr_mult_b * atr[1], prev_low)
    pending_order_id := strategy.entry("Long_B", strategy.long, stop=entry_price)
    pending_entry_price := entry_price
    pending_stop_loss := sl_price
    pending_bars := 0
    strategy_b_state := "LONG"
    entry_price_b := entry_price
    fixed_stop_loss_b := sl_price
    bars_held_b := 0
    highest_since_entry_b := high
    lowest_since_entry_b := low

if short_signal_b
    entry_price := low[1]
    prev_high := high[2]
    sl_price = math.min(entry_price + stop_loss_atr_mult_b * atr[1], prev_high)
    pending_order_id := strategy.entry("Short_B", strategy.short, stop=entry_price)
    pending_entry_price := entry_price
    pending_stop_loss := sl_price
    pending_bars := 0
    strategy_b_state := "SHORT"
    entry_price_b := entry_price
    fixed_stop_loss_b := sl_price
    bars_held_b := 0
    highest_since_entry_b := high
    lowest_since_entry_b := low

// === 策略C入场 ===
// 多头信号: 角度 > 阈值 且 突破前N根K线高点
long_signal_c = enable_strategy_c and (angle_deg_c > angle_threshold_c) and (high > highest_n_c) and not has_position_c

// 空头信号: 角度 < -阈值 且 跌破前N根K线低点
short_signal_c = enable_strategy_c and (angle_deg_c < -angle_threshold_c) and (low < lowest_n_c) and not has_position_c

if long_signal_c
    sl_price = close - stop_loss_atr_mult_c * atr
    tp_price = use_fixed_exit_c ? close + risk_reward_ratio_c * stop_loss_atr_mult_c * atr : na
    strategy.entry("Long_C", strategy.long)
    strategy_c_state := "LONG"
    entry_price_c := close
    bars_held_c := 0
    highest_since_entry_c := high
    lowest_since_entry_c := low

if short_signal_c
    sl_price = close + stop_loss_atr_mult_c * atr
    tp_price = use_fixed_exit_c ? close - risk_reward_ratio_c * stop_loss_atr_mult_c * atr : na
    strategy.entry("Short_C", strategy.short)
    strategy_c_state := "SHORT"
    entry_price_c := close
    bars_held_c := 0
    highest_since_entry_c := high
    lowest_since_entry_c := low

// ============================================
// 绘图
// ============================================
plot(bb_upper, "BB上轨", color=color.new(color.blue, 30), linewidth=1)
plot(bb_lower, "BB下轨", color=color.new(color.blue, 30), linewidth=1)
plot(bb_middle, "BB中轨", color=color.new(color.blue, 60), linewidth=1)
plot(vwap_val, "VWAP", color=color.new(color.purple, 0), linewidth=2)
plot(ema_fast_val, "EMA快线", color=color.new(color.yellow, 0), linewidth=1)
plot(ema_slow_val, "EMA慢线", color=color.new(color.red, 0), linewidth=1)
plot(sma_c, "SMA_C", color=color.new(color.orange, 30), linewidth=1)

// 策略信号标记
plotshape(long_signal_a, "Long A", shape.triangleup, location.belowbar, color.green, size=size.tiny)
plotshape(short_signal_a, "Short A", shape.triangledown, location.abovebar, color.red, size=size.tiny)
plotshape(long_signal_b, "Long B", shape.diamond, location.belowbar, color.lime, size=size.tiny)
plotshape(short_signal_b, "Short B", shape.diamond, location.abovebar, color.maroon, size=size.tiny)
plotshape(long_signal_c, "Long C", shape.circle, location.belowbar, color.aqua, size=size.small)
plotshape(short_signal_c, "Short C", shape.circle, location.abovebar, color.fuchsia, size=size.small)

// 时段背景
bgcolor(is_asian_session ? color.new(color.yellow, 95) : na)
bgcolor(is_european_session ? color.new(color.blue, 95) : na)

// ============================================
// 信息面板
// ============================================
var table panel = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80))

if barstate.islast
    table.cell(panel, 0, 0, "指标", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 50))
    table.cell(panel, 1, 0, "值", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 50))

    rsi_color = rsi < rsi_oversold ? color.green : rsi > rsi_overbought ? color.red : color.white
    table.cell(panel, 0, 1, "RSI", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 1, str.tostring(rsi, "#.#"), text_color=rsi_color, text_size=size.small)

    table.cell(panel, 0, 2, "ATR", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 2, str.tostring(atr, "#.##"), text_color=color.white, text_size=size.small)

    session_txt = is_asian_session ? "亚盘" : is_european_session ? "欧美" : "其他"
    table.cell(panel, 0, 3, "时段", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 3, session_txt, text_color=color.white, text_size=size.small)

    // 策略C角度显示
    angle_color = math.abs(angle_deg_c) > angle_threshold_c ? (angle_deg_c > 0 ? color.green : color.red) : color.white
    table.cell(panel, 0, 4, "C角度", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 4, str.tostring(angle_deg_c, "#.##") + "°", text_color=angle_color, text_size=size.small)

    table.cell(panel, 0, 5, "持仓A", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 5, has_position_a ? (is_long_a ? "多" : "空") : "无", text_color=has_position_a ? color.orange : color.gray, text_size=size.small)

    table.cell(panel, 0, 6, "持仓B", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 6, has_position_b ? (is_long_b ? "多" : "空") : "无", text_color=has_position_b ? color.orange : color.gray, text_size=size.small)

    table.cell(panel, 0, 7, "持仓C", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 7, has_position_c ? (is_long_c ? "多" : "空") : "无", text_color=has_position_c ? color.aqua : color.gray, text_size=size.small)

    table.cell(panel, 0, 8, "突破高", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 8, str.tostring(highest_n_c, "#.##"), text_color=color.white, text_size=size.small)

    table.cell(panel, 0, 9, "突破低", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 9, str.tostring(lowest_n_c, "#.##"), text_color=color.white, text_size=size.small)

    pnl_pct = (strategy.equity / strategy.initial_capital - 1) * 100
    pnl_color = pnl_pct >= 0 ? color.green : color.red
    table.cell(panel, 0, 10, "收益率", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 10, str.tostring(pnl_pct, "#.##") + "%", text_color=pnl_color, text_size=size.small)

    table.cell(panel, 0, 11, "版本", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 11, "v6.0", text_color=color.yellow, text_size=size.small)
